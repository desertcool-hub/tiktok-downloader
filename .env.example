# Public site URL, used by canonical metadata and the sitemap.
SITE_URL=https://www.vidsavenow.com

# X works without additional credentials; public upstreams can still rate-limit.

# Pure Vercel YouTube function; use a random secret with at least 32 characters.
# Set this in Vercel environment variables, never in NEXT_PUBLIC_* variables.
# YOUTUBE_SIGNING_SECRET=your-random-secret-at-least-32-characters

# Optional WeChat share-link service: choose a reachable wx_channel instance.
# WX_CHANNEL_URL=https://your-private-wechat-service.example
# WX_CHANNEL_TOKEN=your-wx-channel-secret-token

# Legacy share-link provider remains supported as an alternative.
# MEDIA_PARSER_URL=http://127.0.0.1:8051

# Existing forwarding mode. Only use a backend running the same updated code.
# Do not set BACKEND_URL on that backend itself.
# BACKEND_URL=https://your-backend.example
